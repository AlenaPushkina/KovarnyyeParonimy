<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40000000"> <!-- Цвет вспышки при нажатии -->

    <!-- Сама форма кнопки -->
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="#FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#FFFFFF" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#2C2C2C" />
        </shape>
    </item>
</ripple>
